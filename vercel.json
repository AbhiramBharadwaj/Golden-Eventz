{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|favicon\\.png$|social-card\\.jpg$|robots\\.txt$|sitemap\\.xml$).*)", "destination": "/index.html" }
  ]
}
